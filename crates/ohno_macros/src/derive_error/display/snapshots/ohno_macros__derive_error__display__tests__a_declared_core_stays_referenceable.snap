---
source: crates/ohno_macros/src/derive_error/display/mod.rs
expression: "lowered(parse_quote!\n{\n    #[display(\"{path}, carrying {carried}\")] struct T\n    {\n        path: String, carried: ohno::OhnoCore,\n        #[doc = \" ohno::generated-core@7f3d9c2a\"] ohno_core: ohno::OhnoCore,\n    }\n})"
---
fn message() {
    let _ = ::std::format!("{}, carrying {}", & self.path, & self.carried);
}
