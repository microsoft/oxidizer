---
fn load(&self) -> Result<(), MyError> {
    let __ohno_result = (|| -> Result<(), MyError> { todo!() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    ::std::format!("counter {}", self.counter),
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}
