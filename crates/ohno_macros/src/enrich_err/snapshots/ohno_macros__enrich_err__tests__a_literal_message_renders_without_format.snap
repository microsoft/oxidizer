fn load() -> Result<(), MyError> {
    let __ohno_result = (|| { todo!() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    "operation failed",
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}
