/// Documented.
pub unsafe extern "C" fn load<T: Clone>(&mut self, value: T) -> Result<T, MyError>
where
    T: Send,
{
    let __ohno_result = (|| { todo!() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new("failed", ::core::file!(), ::core::line!()),
            );
            __ohno_error
        })
}
