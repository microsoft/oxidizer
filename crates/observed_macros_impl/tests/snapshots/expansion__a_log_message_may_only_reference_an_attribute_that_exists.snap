==== accepts "nothing to interpolate" ====
struct Subject {
    status: i64,
    original: ClassifiedString,
    request_id: ClassifiedString,
}
const _: () = {
    impl ::observed::Event for Subject {
        const DESCRIPTION: ::observed::metadata::EventDescription = ::observed::metadata::EventDescription::new(
            "e",
            ::core::option::Option::Some(::core::any::TypeId::of::<Subject>()),
            ::core::option::Option::Some(
                ::observed::metadata::LogDescription::new(
                    "e",
                    ::observed::Severity::Info,
                    ::core::option::Option::Some("nothing to interpolate"),
                ),
            ),
            ::core::option::Option::None,
            false,
            false,
        );
        fn visit_fields(
            &self,
            visitor: &mut ::observed::processing::FieldVisitorFn<'_>,
        ) -> ::core::ops::ControlFlow<()> {
            {
                const FIELD_DESC: ::observed::metadata::FieldDescriptor = ::observed::metadata::FieldDescriptor::new(
                    "status",
                    ::core::option::Option::Some(
                        ::observed::metadata::LogFieldEntry::new("status"),
                    ),
                    ::core::option::Option::None,
                );
                visitor(&FIELD_DESC, &|_| ::observed::Value::from(self.status.clone()))?;
            }
            {
                const FIELD_DESC: ::observed::metadata::FieldDescriptor = ::observed::metadata::FieldDescriptor::new(
                    "original",
                    ::core::option::Option::Some(
                        ::observed::metadata::LogFieldEntry::new("renamed"),
                    ),
                    ::core::option::Option::None,
                );
                visitor(
                    &FIELD_DESC,
                    &|engine| ::observed::Value::from_redacted(&self.original, engine),
                )?;
            }
            ::core::ops::ControlFlow::Continue(())
        }
    }
};

