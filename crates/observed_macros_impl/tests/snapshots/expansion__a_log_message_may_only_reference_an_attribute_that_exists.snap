    #[dimension(log = "renamed")]
    original: ClassifiedString,
    #[dimension(log = exclude)]
    request_id: ClassifiedString,
}

---- yields ----
struct Subject {
    status: i64,
    original: ClassifiedString,
    request_id: ClassifiedString,
}
const _: () = {
    impl ::observed::Event for Subject {
        const DESCRIPTION: ::observed::metadata::EventDescription = ::observed::__private::event_description(
            "e",
            ::core::option::Option::Some(::core::any::TypeId::of::<Subject>()),
            ::core::option::Option::Some(
                ::observed::__private::log_description(
                    "e",
                    ::observed::Severity::Info,
                    ::core::option::Option::Some("nothing to interpolate"),
                ),
            ),
            ::core::option::Option::None,
            false,
            &::observed::__private::event_fields([
                ::observed::__private::field_descriptor(
                    "status",
                    ::core::option::Option::Some(
                        ::observed::__private::log_field("status"),
                    ),
                    ::core::option::Option::None,
                ),
                ::observed::__private::field_descriptor(
                    "original",
                    ::core::option::Option::Some(
                        ::observed::__private::log_field("renamed"),
                    ),
                    ::core::option::Option::None,
                ),
            ]),
        );
        fn visit_fields(
            &self,
            visitor: &mut ::observed::processing::FieldVisitorFn<'_>,
        ) -> ::core::ops::ControlFlow<()> {
            {
                visitor(
                    &<Self as ::observed::Event>::DESCRIPTION.fields()[0usize],
                    &|_| ::observed::Value::from(self.status.clone()),
                )?;
            }
            {
                visitor(
                    &<Self as ::observed::Event>::DESCRIPTION.fields()[1usize],
                    &|engine| ::observed::Value::from_redacted(&self.original, engine),
                )?;
            }
            ::core::ops::ControlFlow::Continue(())
        }
    }
};

