---
source: crates/observed_macros_impl/tests/expansion.rs
expression: "expand_enrichment(r#\"\n            struct RequestContext {\n                method: ClassifiedString,\n                #[unredacted]\n                status: i64,\n                #[data_class(DataTaxonomy::Euii)]\n                username: String,\n                #[dimension(log = \"http.method\")]\n                renamed: ClassifiedString,\n                #[dimension(log = exclude)]\n                internal: ClassifiedString,\n            }\n            \"#,)"
---
const _: () = {
    impl ::observed::enrichment::Enrichment for RequestContext {
        fn into_entries(
            self,
        ) -> ::std::vec::Vec<::observed::__private::EnrichmentEntry> {
            let mut entries = ::std::vec::Vec::with_capacity(5usize);
            entries
                .push(
                    ::observed::__private::EnrichmentEntry::new("method", self.method),
                );
            entries
                .push(
                    ::observed::__private::EnrichmentEntry::unclassified(
                        "status",
                        self.status,
                    ),
                );
            entries
                .push(
                    ::observed::__private::EnrichmentEntry::new(
                        "username",
                        ::observed::__private::Sensitive::new(
                            self.username,
                            DataTaxonomy::Euii,
                        ),
                    ),
                );
            entries
                .push(
                    ::observed::__private::EnrichmentEntry::new(
                        "http.method",
                        self.renamed,
                    ),
                );
            entries
                .push(
                    ::observed::__private::EnrichmentEntry::new(
                            "internal",
                            self.internal,
                        )
                        .exclude_from_logs(),
                );
            entries
        }
    }
};
