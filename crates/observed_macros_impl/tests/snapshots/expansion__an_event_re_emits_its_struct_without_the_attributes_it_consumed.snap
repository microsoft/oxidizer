---
source: crates/observed_macros_impl/tests/expansion.rs
expression: "expand_event(r#\"\"http.request\"\"#,\nr#\"\n        #[derive(Debug)]\n        #[info(\"{method} handled as {status}\", name = \"http.request.log\")]\n        struct HttpRequest {\n            #[dimension(log = \"method\")]\n            method: ClassifiedString,\n            #[allow(dead_code)]\n            #[unredacted]\n            status: i64,\n            #[data_class(DataTaxonomy::Euii)]\n            user: String,\n            #[dimension(log = exclude)]\n            request_id: ClassifiedString,\n        }\n        \"#,)"
---
#[derive(Debug)]
struct HttpRequest {
    method: ClassifiedString,
    #[allow(dead_code)]
    status: i64,
    user: String,
    request_id: ClassifiedString,
}
