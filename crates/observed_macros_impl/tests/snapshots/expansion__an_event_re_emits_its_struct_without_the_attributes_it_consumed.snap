                ::core::option::Option::Some(
                    ::observed::metadata::LogDescription::new(
                        "http.request.log",
                        ::observed::Severity::Info,
                        ::core::option::Option::Some("{method} handled as {status}"),
                    ),
                ),
                ::core::option::Option::None,
                false,
                false,
            )
            .with_fields(
                &[
                    ::observed::metadata::FieldDescriptor::new(
                            "method",
                            ::core::option::Option::Some(
                                ::observed::metadata::LogFieldEntry::new("method"),
                            ),
                            ::core::option::Option::None,
                        )
                        .with_field_index(0usize),
                    ::observed::metadata::FieldDescriptor::new(
                            "status",
                            ::core::option::Option::Some(
                                ::observed::metadata::LogFieldEntry::new("status"),
                            ),
                            ::core::option::Option::None,
                        )
                        .with_field_index(1usize),
                    ::observed::metadata::FieldDescriptor::new(
                            "user",
                            ::core::option::Option::Some(
                                ::observed::metadata::LogFieldEntry::new("user"),
                            ),
                            ::core::option::Option::None,
                        )
                        .with_field_index(2usize),
                ],
            );
        fn visit_fields(
            &self,
            visitor: &mut ::observed::processing::FieldVisitorFn<'_>,
        ) -> ::core::ops::ControlFlow<()> {
            {
                visitor(
                    &<Self as ::observed::Event>::DESCRIPTION.fields()[0usize],
                    &|engine| ::observed::Value::from_redacted(&self.method, engine),
                )?;
            }
            {
                visitor(
                    &<Self as ::observed::Event>::DESCRIPTION.fields()[1usize],
                    &|_| ::observed::Value::from(self.status.clone()),
                )?;
            }
            {
                visitor(
                    &<Self as ::observed::Event>::DESCRIPTION.fields()[2usize],
                    &|engine| ::observed::Value::from_redacted(
                        &::observed::__private::Sensitive::new(
