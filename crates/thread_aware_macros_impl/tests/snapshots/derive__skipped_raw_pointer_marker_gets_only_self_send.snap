impl<T> ::thread_aware::ThreadAware for RawMarker<T>
where
    RawMarker<T>: ::core::marker::Send,
{
    fn relocate(
        &mut self,
        __thread_aware_source: ::core::option::Option<
            ::thread_aware::affinity::Affinity,
        >,
        __thread_aware_destination: ::thread_aware::affinity::Affinity,
    ) {
        ::thread_aware::ThreadAware::relocate(
            &mut self.0,
            __thread_aware_source,
            __thread_aware_destination,
        );
    }
}
