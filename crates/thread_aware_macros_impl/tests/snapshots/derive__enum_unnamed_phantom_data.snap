impl<
    T: ::thread_aware::ThreadAware,
    U: ::thread_aware::ThreadAware,
> ::thread_aware::ThreadAware for EnumUnnamedPhantom<T, U> {
    fn relocate(
        &mut self,
        __thread_aware_source: ::core::option::Option<&::thread_aware::Thread>,
        __thread_aware_destination: &::thread_aware::Thread,
    ) {
        match *self {
            Self::Variant(
                ref mut __thread_aware_field_0,
                ref mut __thread_aware_field_1,
            ) => {
                ::thread_aware::ThreadAware::relocate(
                    __thread_aware_field_0,
                    __thread_aware_source,
                    __thread_aware_destination,
                );
                ::thread_aware::ThreadAware::relocate(
                    __thread_aware_field_1,
                    __thread_aware_source,
                    __thread_aware_destination,
                );
            }
            Self::Other(
                ref mut __thread_aware_field_0,
                ref mut __thread_aware_field_1,
            ) => {
                ::thread_aware::ThreadAware::relocate(
                    __thread_aware_field_0,
                    __thread_aware_source,
                    __thread_aware_destination,
                );
                ::thread_aware::ThreadAware::relocate(
                    __thread_aware_field_1,
                    __thread_aware_source,
                    __thread_aware_destination,
                );
            }
        }
    }
}
