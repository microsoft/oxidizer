impl<T: ::thread_aware::ThreadAware> ::thread_aware::ThreadAware for WithPhantom<T> {
    fn relocate(
        &mut self,
        __thread_aware_source: ::core::option::Option<&::thread_aware::Thread>,
        __thread_aware_destination: &::thread_aware::Thread,
    ) {
        ::thread_aware::ThreadAware::relocate(
            &mut self.data,
            __thread_aware_source,
            __thread_aware_destination,
        );
        ::thread_aware::ThreadAware::relocate(
            &mut self.marker,
            __thread_aware_source,
            __thread_aware_destination,
        );
    }
}
