#[allow(
    clippy::unused_self,
    reason = "Instance receivers select the real or fake implementation"
)]
impl __fakeable__MyService::MyService {
    #[cfg(any())]
    pub(crate) fn unsupported(&mut self) {}
}
impl MyService {
    #[cfg(any())]
    #[allow(unused_mut)]
    #[allow(clippy::used_underscore_binding)]
    pub(crate) fn unsupported(&mut self) {
        match &mut self.inner {
            __fakeable__MyService::Enum::Real(__fakeable_real) => {
                __fakeable_real.unsupported()
            }
            #[cfg(test)]
            __fakeable__MyService::Enum::Fake(__fakeable_fake) => {
                __fakeable_fake.unsupported()
            }
        }
    }
}
#[cfg(test)]
#[cfg(any())]
::core::compile_error! {
    "generate_mockall_fake does not support mutable receiver methods; use a manual fake implementation"
}
#[cfg(test)]
#[allow(clippy::all)]
#[allow(clippy::pedantic)]
#[allow(clippy::style)]
pub mod fakes {
    use super::*;
    ::mockall::mock! {
        #[derive(Debug)] pub MyService {}
    }
}
