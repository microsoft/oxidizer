---
source: crates/ohno_macros_impl/tests/public_api.rs
expression: output
---
// ======== named struct ========

#[ohno::error]
struct T {
    path: String,
}
// ---- expands to ----

#[derive(::ohno::Error)]
struct T {
    path: String,
    /// ohno::generated-core@7f3d9c2a
    ohno_core: ::ohno::OhnoCore,
}

// ======== a colliding core name is numbered ========

#[ohno::error]
struct T {
    ohno_core: u32,
    ohno_core_1: u32,
}
// ---- expands to ----

#[derive(::ohno::Error)]
struct T {
    ohno_core: u32,
    ohno_core_1: u32,
    /// ohno::generated-core@7f3d9c2a
    ohno_core_2: ::ohno::OhnoCore,
}

// ======== tuple struct gains a trailing core ========

#[ohno::error]
struct T(String);
// ---- expands to ----

#[derive(::ohno::Error)]
struct T(
    String,
    /// ohno::generated-core@7f3d9c2a
    ::ohno::OhnoCore,
);

// ======== unit struct becomes a tuple struct ========

#[ohno::error]
struct T;
// ---- expands to ----

#[derive(::ohno::Error)]
struct T(
    /// ohno::generated-core@7f3d9c2a
    ::ohno::OhnoCore,
);
