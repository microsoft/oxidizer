}

// ======== a self-prefixed argument is left alone ========

#[enrich_err("could not load {}", self.path)]
fn load(&self) -> Result<(), MyError> {
    inner()
}
// ---- expands to ----

fn load(&self) -> Result<(), MyError> {
    let __ohno_result = (|| { inner() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    ::std::format!("could not load {}", self.path),
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}

// ======== the signature survives untouched ========

#[enrich_err]
/// Documented.
pub(crate) unsafe extern "C" fn load<A: Clone>(
    &mut self,
    path: &str,
    count: usize,
) -> Result<A, MyError>
where
    A: Send,
{
    inner()
}
// ---- expands to ----

/// Documented.
pub(crate) unsafe extern "C" fn load<A: Clone>(
    &mut self,
    path: &str,
    count: usize,
) -> Result<A, MyError>
where
    A: Send,
{
    let __ohno_result = (|| { inner() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    "error in function load",
                    ::core::file!(),
                    ::core::line!(),
