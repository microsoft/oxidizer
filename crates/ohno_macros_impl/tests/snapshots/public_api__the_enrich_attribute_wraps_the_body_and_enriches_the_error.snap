// ======== a bare attribute names the function ========

#[enrich_err]
fn load() -> Result<(), MyError> {
    inner()
}
// ---- expands to ----

fn load() -> Result<(), MyError> {
    let __ohno_result = (|| { inner() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    "error in function load",
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}

// ======== a literal message renders without format ========

#[enrich_err("could not load")]
fn load() -> Result<(), MyError> {
    inner()
}
// ---- expands to ----

fn load() -> Result<(), MyError> {
    let __ohno_result = (|| { inner() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    "could not load",
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}

// ======== an inline capture goes through format ========

#[enrich_err("could not load {path}")]
fn load(path: &str) -> Result<(), MyError> {
    inner()
}
// ---- expands to ----

fn load(path: &str) -> Result<(), MyError> {
    let __ohno_result = (|| { inner() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    ::std::format!("could not load {path}"),
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}

// ======== arguments are passed through unchanged ========

#[enrich_err("could not load {}", path)]
fn load(path: &str) -> Result<(), MyError> {
    inner()
}
// ---- expands to ----

fn load(path: &str) -> Result<(), MyError> {
    let __ohno_result = (|| { inner() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    ::std::format!("could not load {}", path),
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}

// ======== arguments force a format call even with no placeholder ========

