}

// ======== an async function awaits an async block ========

#[enrich_err]
async fn load() -> Result<(), MyError> {
    inner().await
}
// ---- expands to ----

async fn load() -> Result<(), MyError> {
    let __ohno_result = async { inner().await }.await;
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    "error in function load",
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}
