---
source: crates/ohno_macros_impl/tests/public_api.rs
expression: output
---
// ======== associated constant ========

#[derive(Error)]
#[display("value {}", Self::LABEL.len())]
struct T {
    path: String,
    other: u32,
    inner: ohno::OhnoCore,
}
// ---- expands to ----

::core::compile_error! {
    "`#[display(...)]` positional arguments are implicitly scoped to `self`, so each argument must be rooted in a field or method of `self`"
}

// ======== string literal receiver ========

#[derive(Error)]
#[display("value {}", "prefix".len())]
struct T {
    path: String,
    other: u32,
    inner: ohno::OhnoCore,
}
// ---- expands to ----

::core::compile_error! {
    "`#[display(...)]` positional arguments are implicitly scoped to `self`, so each argument must be rooted in a field or method of `self`"
}

