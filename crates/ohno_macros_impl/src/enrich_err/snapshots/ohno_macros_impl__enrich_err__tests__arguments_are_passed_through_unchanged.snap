---
fn load(data: &[u8]) -> Result<(), MyError> {
    let __ohno_result = (|| { todo!() })();
    __ohno_result
        .map_err(|mut __ohno_error| {
            ::ohno::Enrichable::add_enrichment(
                &mut __ohno_error,
                ::ohno::EnrichmentEntry::new(
                    ::std::format!("read {} bytes", data.len()),
                    ::core::file!(),
                    ::core::line!(),
                ),
            );
            __ohno_error
        })
}
