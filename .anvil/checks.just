# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Regenerate with cargo-anvil to update this file.

# Compute modified, affected, and required package files with cargo-delta.
# Compute the impact set and write its clean cache or dirty local output.
[group("anvil")]
[script("pwsh", "-NoProfile")]
anvil-impact:
    $ErrorActionPreference = 'Stop'
    if ($env:ANVIL_IMPACT_INVOCATION_ID -notmatch '^\d+$') {
        Write-Error "anvil-impact: ANVIL_IMPACT_INVOCATION_ID must be a numeric Just process id"
        exit 2
    }
    # Exit 2 = invalid caller configuration (bad ANVIL_IMPACT), distinct from
    # the generic 1 used for operational failures -- see _anvil-impact-snapshot.
    if ($env:ANVIL_IMPACT -and $env:ANVIL_IMPACT -notin @('off', 'consume')) {
        [Console]::Error.WriteLine("anvil: ANVIL_IMPACT='$($env:ANVIL_IMPACT)' is not recognized (expected 'off', 'consume', or unset).")
        exit 2
    }
    if ($env:ANVIL_IMPACT -eq 'off') { exit 0 }
    if ($env:ANVIL_IMPACT -eq 'consume') {
        $inputDir = if ($env:ANVIL_IMPACT_INPUT_DIR) { $env:ANVIL_IMPACT_INPUT_DIR } else { 'target/anvil/impact' }
        # consume = trust an already-downloaded cache verbatim, so assert the
        # cache is actually present. If the CI download ever stops landing at
        # target/anvil/impact/ (renamed artifact, a missing download step, or
        # an adopter invoking the group action directly), every scoped check
        # would otherwise silently widen to --workspace and the pipeline would
        # stay green. Fail loudly instead. (Presence only -- freshness stays a
        # deliberate non-goal in consume mode.)
        $missing = @('modified', 'affected', 'required') |
            Where-Object { -not (Test-Path -LiteralPath (Join-Path $inputDir "$_.packages") -PathType Leaf) }
        if ($missing.Count -gt 0) {
            Write-Error "anvil-impact: ANVIL_IMPACT=consume but the input impact cache is missing ($($missing -join ', ') package file(s) absent under $inputDir). A complete cache holds modified.packages, affected.packages and required.packages. The read directory is ANVIL_IMPACT_INPUT_DIR when set, otherwise target/anvil/impact -- check that variable if the path above is not where you expected. Supply a complete impact cache before scoped checks run."
            exit 1
        }
        exit 0
    }

    $dirtyChanges = @(git status --porcelain -- . ':(exclude)target/' | Where-Object { $_ })
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $dirty = $dirtyChanges.Count -gt 0
    $cloudCompute = ($env:GITHUB_ACTIONS -eq 'true') -or ($env:TF_BUILD -eq 'True')
    if ($dirty -and $cloudCompute) {
        Write-Error 'anvil-impact: cloud impact computation requires a clean working tree; restore or commit all checkout changes before running the impact job.'
        exit 1
    }
    $cleanImpactDir = 'target/anvil/impact'
    $dirtyImpactRoot = 'target/anvil/impact-dirty'
    $impactDir = if ($dirty) {
        Join-Path $dirtyImpactRoot ([System.Guid]::NewGuid().ToString('N'))
    } else {
        $cleanImpactDir
    }
    $workspaceHash = [Convert]::ToHexString(
        [System.Security.Cryptography.SHA256]::HashData(
            [System.Text.Encoding]::UTF8.GetBytes((Get-Location).Path)
        )
    )
    $publicationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-publication-$workspaceHash")
    if (-not $dirty) {
        try {
            [void]$publicationMutex.WaitOne()
            foreach ($marker in @(
                (Join-Path $dirtyImpactRoot "active-$env:ANVIL_IMPACT_INVOCATION_ID"),
                (Join-Path $dirtyImpactRoot 'active')
            )) {
                if (Test-Path -LiteralPath $marker -PathType Leaf) {
                    Remove-Item -LiteralPath $marker -Force -ErrorAction Stop
                }
            }
        } finally {
            $publicationMutex.ReleaseMutex()
        }
    } else {
        $invocationMarker = Join-Path $dirtyImpactRoot "active-$env:ANVIL_IMPACT_INVOCATION_ID"
    }
    & "{{ just_executable() }}" _anvil-impact-snapshot $impactDir
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    if ($dirty) {
        $publishDirty = {
            try {
                [void]$publicationMutex.WaitOne()
                [System.IO.Directory]::CreateDirectory($dirtyImpactRoot) | Out-Null
                foreach ($marker in @($invocationMarker, (Join-Path $dirtyImpactRoot 'active'))) {
                    $pendingMarker = Join-Path $dirtyImpactRoot "pending-$([System.Guid]::NewGuid().ToString('N'))"
                    Set-Content -LiteralPath $pendingMarker -Value $impactDir -Encoding UTF8 -NoNewline
                    [System.IO.File]::Move($pendingMarker, $marker, $true)
                }

                $activeGenerations = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
                foreach ($marker in @(Get-ChildItem -LiteralPath $dirtyImpactRoot -File -Filter 'active*' -ErrorAction SilentlyContinue)) {
                    if ($marker.Name -match '^active-(\d+)$') {
                        $invocationProcess = Get-Process -Id ([int]$Matches[1]) -ErrorAction SilentlyContinue
                        if (-not $invocationProcess) {
                            Remove-Item -LiteralPath $marker.FullName -Force -ErrorAction Stop
                            continue
                        }
                    }
                    $markerGeneration = "$(Get-Content -Raw -LiteralPath $marker.FullName)".Trim()
                    if ($markerGeneration) {
                        [void]$activeGenerations.Add((Resolve-Path -LiteralPath $markerGeneration).Path)
                    }
                }

                # Eight is intentionally generous relative to the tiny local
                # cache cost and keeps cleanup bounded without thrashing.
                $completedGenerations = @(Get-ChildItem -LiteralPath $dirtyImpactRoot -Directory -ErrorAction SilentlyContinue |
                    Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName 'complete') -PathType Leaf } |
                    Sort-Object -Property LastWriteTimeUtc -Descending)
                $retiredGenerations = @($completedGenerations | Select-Object -Skip 8)
                $abandonedGenerations = @(Get-ChildItem -LiteralPath $dirtyImpactRoot -Directory -ErrorAction SilentlyContinue |
                    Where-Object {
                        if (Test-Path -LiteralPath (Join-Path $_.FullName 'complete') -PathType Leaf) { return $false }
                        $producerFile = Join-Path $_.FullName 'producer.pid'
                        if (-not (Test-Path -LiteralPath $producerFile -PathType Leaf)) { return $false }
                        $producerId = 0
                        [void][int]::TryParse("$(Get-Content -Raw -LiteralPath $producerFile)".Trim(), [ref]$producerId)
                        $producerId -gt 0 -and -not (Get-Process -Id $producerId -ErrorAction SilentlyContinue)
                    })
                foreach ($oldGeneration in @($retiredGenerations + $abandonedGenerations | Sort-Object -Unique FullName)) {
                    if ($activeGenerations.Contains($oldGeneration.FullName)) { continue }
                    $generationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-generation-$($oldGeneration.Name)")
                    $locked = $false
                    try {
                        $locked = $generationMutex.WaitOne(0)
                        if ($locked -and (Test-Path -LiteralPath $oldGeneration.FullName -PathType Container)) {
                            Remove-Item -LiteralPath $oldGeneration.FullName -Recurse -Force -ErrorAction Stop
                        }
                    } catch [System.UnauthorizedAccessException] {
                        # Leave the generation for a later cleanup pass.
                    } catch [System.IO.IOException] {
                        # Leave the generation for a later cleanup pass.
                    } finally {
                        if ($locked) { $generationMutex.ReleaseMutex() }
                        $generationMutex.Dispose()
                    }
                }
            } finally {
                $publicationMutex.ReleaseMutex()
            }
        }
    }
    $deltaConfigDirty = $dirty -and (@(git status --porcelain -- .delta.toml | Where-Object { $_ }).Count -gt 0)
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $baselineImpactDir = if ($dirty) { $impactDir } else { $cleanImpactDir }
    $snapDir = Join-Path $impactDir 'snapshots'
    $baselineSnapDir = Join-Path $baselineImpactDir 'snapshots'
    $baselineJson = Join-Path $baselineSnapDir 'baseline.json'
    $currentJson = Join-Path $snapDir 'current.json'
    $baselineKeyFile = Join-Path $baselineSnapDir 'baseline.key'
    $currentKeyFile = Join-Path $snapDir 'current.key'
    $packageFiles = @('modified', 'affected', 'required') | ForEach-Object { Join-Path $impactDir "$_.packages" }
    $impactStateFile = Join-Path $impactDir 'impact.state'
    $invocationRoot = 'target/anvil/impact-invocations'
    $invocationDir = Join-Path $invocationRoot $env:ANVIL_IMPACT_INVOCATION_ID
    $publishInvocation = {
        try {
            [void]$publicationMutex.WaitOne()
            [System.IO.Directory]::CreateDirectory($invocationRoot) | Out-Null
            $pending = Join-Path $invocationRoot "pending-$([System.Guid]::NewGuid().ToString('N'))"
            [System.IO.Directory]::CreateDirectory($pending) | Out-Null
            foreach ($packageFile in $packageFiles) {
                Copy-Item -LiteralPath $packageFile -Destination (Join-Path $pending (Split-Path $packageFile -Leaf)) -Force
            }
            if (Test-Path -LiteralPath $invocationDir -PathType Container) {
                Remove-Item -LiteralPath $invocationDir -Recurse -Force
            }
            [System.IO.Directory]::Move($pending, $invocationDir)
            foreach ($oldInvocation in @(Get-ChildItem -LiteralPath $invocationRoot -Directory -ErrorAction SilentlyContinue)) {
                $invocationId = 0
                if (-not [int]::TryParse($oldInvocation.Name, [ref]$invocationId)) { continue }
                if ($invocationId -eq [int]$env:ANVIL_IMPACT_INVOCATION_ID) { continue }
                if (-not (Get-Process -Id $invocationId -ErrorAction SilentlyContinue)) {
                    Remove-Item -LiteralPath $oldInvocation.FullName -Recurse -Force -ErrorAction SilentlyContinue
                }
            }
        } finally {
            $publicationMutex.ReleaseMutex()
        }
    }

    if ($dirty) {
        Write-Host "anvil-impact: using fresh impact for $($dirtyChanges.Count) uncommitted change(s) in the local working tree" -ForegroundColor Yellow
    }

    $wantState = $null
    if (-not $dirty) {
        $wantState = ("$(Get-Content -Raw $baselineKeyFile)".Trim()) + ' ' + ("$(Get-Content -Raw $currentKeyFile)".Trim())
        $fresh = (Test-Path $impactStateFile) -and `
            ("$(Get-Content -Raw $impactStateFile)".Trim() -eq $wantState) -and `
            (@($packageFiles | Where-Object { -not (Test-Path -LiteralPath $_ -PathType Leaf) }).Count -eq 0)
        if ($fresh) {
            Write-Host 'anvil-impact: package selections up to date (cache hit)'
            & $publishInvocation
            exit 0
        }
    }

    if (Test-Path (Join-Path $baselineSnapDir 'baseline-no-workspace')) {
        Write-Host 'anvil-impact: baseline has no workspace; selecting the current workspace'
        $metadata = (& cargo metadata --no-deps --format-version 1 | Out-String) | ConvertFrom-Json
        if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-impact: cargo metadata failed'; exit 1 }
        $members = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
        foreach ($id in $metadata.workspace_members) { [void]$members.Add([string]$id) }
        $specs = @($metadata.packages | Where-Object { $members.Contains([string]$_.id) } | ForEach-Object { "$($_.name)@$($_.version)" } | Sort-Object)
        Set-Content -LiteralPath (Join-Path $impactDir 'modified.packages') -Value '' -Encoding UTF8 -NoNewline
        foreach ($tier in @('affected', 'required')) {
            Set-Content -LiteralPath (Join-Path $impactDir "$tier.packages") -Value ($specs -join "`n") -Encoding UTF8 -NoNewline
        }
    } else {
        $deltaArgs = @()
        if (Test-Path '.delta.toml') { $deltaArgs = @('--config', (Resolve-Path '.delta.toml').Path) }
        $stableArgs = @({{ anvil_stable_toolchain_arg }})
        foreach ($tier in @('modified', 'affected', 'required')) {
            $output = Join-Path $impactDir "$tier.packages"
            $args = @('delta') + $deltaArgs + @(
                'impact', '--baseline', $baselineJson, '--current', $currentJson,
                "--$tier", '--format', 'packages', '--output', $output
            )
            & cargo @stableArgs @args
            if ($LASTEXITCODE -ne 0) { Write-Error "anvil-impact: cargo delta impact --$tier failed"; exit 1 }
            if (-not (Test-Path -LiteralPath $output -PathType Leaf)) {
                Set-Content -LiteralPath $output -Value '' -Encoding UTF8 -NoNewline
            }
            Write-Host "anvil-impact: $tier -> $output"
        }
    }

    if (-not $dirty) {
        Set-Content -LiteralPath $impactStateFile -Value $wantState -Encoding UTF8 -NoNewline
    }
    & $publishInvocation
    if ($dirty) {
        $generationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-generation-$(Split-Path $impactDir -Leaf)")
        try {
            [void]$generationMutex.WaitOne()
            New-Item -ItemType File -Path (Join-Path $impactDir 'complete') -Force | Out-Null
            & $publishDirty
        } finally {
            $generationMutex.ReleaseMutex()
            $generationMutex.Dispose()
        }
    }

# Build all workspace targets and features, optionally for one package or profile.
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("profile", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
anvil-build package="" profile="": anvil-build-validate-prereqs
    cargo each {{ if package == "" { "--workspace" } else { "--package " + quote(package) } }} --once -- cargo {{ anvil_stable_toolchain_arg }} build '{packages}' {{ if profile == "" { "" } else { "--profile " + quote(profile) } }} --all-features --all-targets --locked

# Assess dependency feature and version risk with cargo-aprz.
anvil-aprz: anvil-aprz-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} aprz deps --github-token-from-gh --error-if-high-risk --console appraisal

# Audit locked dependencies against the RustSec advisory database.
anvil-audit: anvil-audit-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} audit

# Compile affected benchmarks without running them.
anvil-bench: anvil-bench-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} bench '{packages}' --all-features --no-run

# Discover and fuzz affected Bolero targets.
anvil-bolero campaign="pr": anvil-bolero-validate-prereqs _ensure-target-dir
    {{ if campaign == "pr" || campaign == "scheduled" { "# valid campaign" } else { error("unknown Bolero campaign '" + campaign + "'; expected 'pr' or 'scheduled'") } }}
    {{ bolero_command_prefix }}cargo +{{ rust_nightly }} each {{ anvil_affected_selection }} -- cargo +{{ rust_nightly }} bolero list --profile release --target {{ quote(anvil_bolero_host_target) }} --package '{name}' > {{ quote(anvil_bolero_targets_file) }}
    {{ bolero_command_prefix }}cargo +{{ rust_nightly }} each --json-lines-file {{ quote(anvil_bolero_targets_file) }} --keep-going -- cargo +{{ rust_nightly }} bolero test --profile release --target {{ quote(anvil_bolero_host_target) }} --engine libfuzzer {{ if campaign == "pr" { "--runs 30000 -S 2027" } else { "-T 90s" } }} --package '{json:package}' '{json:test}'
    {{ bolero_command_prefix }}rm {{ quote(anvil_bolero_targets_file) }}

# Run affected tests with cargo-careful runtime checks.
anvil-careful: anvil-careful-validate-prereqs anvil-impact
    {{ anvil_careful_prefix }}cargo +{{ rust_nightly }} each {{ anvil_affected_selection }} --once -- cargo +{{ rust_nightly }} careful test '{packages}' --all-features --locked --target-dir {{ quote(anvil_careful_target_dir) }}

# Check required packages across bounded feature combinations.
anvil-cargo-hack: anvil-cargo-hack-validate-prereqs anvil-impact
    cargo each {{ anvil_required_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} hack '{packages}' --feature-powerset --depth 2 check

# Verify Cargo manifests are sorted and formatted consistently.
anvil-cargo-sort: anvil-cargo-sort-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} sort --workspace --grouped --check --check-format

# Compile each affected package independently with and without default features.
anvil-check-all-targets: anvil-check-all-targets-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --keep-going -- cargo {{ anvil_stable_toolchain_arg }} check --package '{spec}' --all-targets --locked
    cargo each {{ anvil_affected_selection }} --keep-going -- cargo {{ anvil_stable_toolchain_arg }} check --package '{spec}' --all-targets --no-default-features --locked

# Lint affected packages and all targets with warnings denied.
anvil-clippy: anvil-clippy-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} clippy '{packages}' --all-targets --all-features --locked -- -D warnings

# Validate dependency licenses, bans, sources, and advisories.
anvil-deny: anvil-deny-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} deny check

# Build required-package documentation with rustdoc warnings denied.
[arg("open", long, value="true")]
anvil-doc-build open="false": anvil-doc-build-validate-prereqs anvil-impact
    cargo each {{ anvil_required_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} doc '{packages}' --config {{ quote('build.rustdocflags=["-D","warnings"]') }} --all-features --no-deps {{ if open == "true" { "--open" } else { "" } }}

# Run affected package doctests with all and default features.
anvil-doc-test: anvil-doc-test-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --filter doctest -- cargo {{ anvil_stable_toolchain_arg }} test --doc --package '{cargo-spec}' --all-features --locked
    cargo each {{ anvil_affected_selection }} --filter doctest -- cargo {{ anvil_stable_toolchain_arg }} test --doc --package '{cargo-spec}' --locked

# Reject dependency cycles between workspace packages.
anvil-ensure-no-cyclic-deps: anvil-ensure-no-cyclic-deps-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} ensure-no-cyclic-deps

# Verify workspace dependencies disable default features.
anvil-ensure-no-default-features: anvil-ensure-no-default-features-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} ensure-no-default-features

# Build and run eligible affected examples; explicit selection overrides exclusions.
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("example", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("timeout", long, pattern='(?:[1-9][0-9]{0,2}|[12][0-9]{3}|3[0-5][0-9]{2}|3600)')]
anvil-examples package="" example="" timeout="30": anvil-examples-validate-prereqs anvil-impact
    cargo each {{ if example == "" { if package == "" { anvil_affected_selection } else { "--package " + quote(package) } } else if package == "" { error("--example requires --package") } else { "--package " + quote(package) } }} --once -- cargo {{ anvil_stable_toolchain_arg }} build '{packages}' {{ if example == "" { "--examples" } else { "--example " + quote(example) } }} --all-features --locked
    cargo each {{ if package == "" { anvil_affected_selection } else { "--package " + quote(package) } }} --each-target example --target-filter {{ quote(if example == "" { "not name-in-metadata:anvil.examples.no-run" } else { "name:" + example }) }} {{ if example == "" { "" } else { "--require-target-per-package" } }} --timeout {{ timeout }}s --keep-going -- cargo {{ anvil_stable_toolchain_arg }} run --config {{ quote('env.ANVIL_EXAMPLE="1"') }} --package '{cargo-spec}' --example '{target}' --all-features --locked

# Reject unapproved external types in affected public APIs.
anvil-external-types: anvil-external-types-validate-prereqs anvil-impact
    cargo +{{ rust_nightly_external_types }} each {{ anvil_affected_selection }} --filter target-kind:lib --keep-going -- cargo +{{ rust_nightly_external_types }} check-external-types --manifest-path '{manifest}'

# Check or fix Rust formatting for modified workspace packages.
[group("anvil")]
[arg("fix", long, value="true")]
anvil-fmt fix="false": anvil-fmt-validate-prereqs anvil-impact
    cargo +{{ rust_nightly }} each {{ anvil_modified_selection }} --keep-going -- cargo +{{ rust_nightly }} fmt --manifest-path '{manifest}' {{ if fix == "true" { "" } else { "--check" } }}

# Verify source files carry the required license header.
anvil-license-headers: anvil-license-headers-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} heather

# Run affected tests and enforce coverage policy in supported feature modes.
anvil-llvm-cov: anvil-llvm-cov-validate-prereqs anvil-impact
    cargo +{{ rust_nightly }} each {{ anvil_affected_selection }} --once -- {{ anvil_coverage_gate_command }} {{ anvil_explicit_package_args }} run --configuration all-features --configuration no-default-features --coverage-dir target/coverage --no-coverage-target aarch64-pc-windows-msvc

# Run affected Loom test targets with the Loom configuration.
anvil-loom: anvil-loom-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --filter feature:loom --each-target test --target-filter required-feature:loom --require-target-per-package -- cargo {{ anvil_stable_toolchain_arg }} test --config {{ quote('build.rustflags=["--cfg","loom"]') }} --package '{cargo-spec}' --release --all-features --locked --test '{target}' -- --test-threads=1

# Run Miri tests for affected workspace packages.
[arg("example", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("test", long, pattern='(?:[A-Za-z0-9_.:-]+)?')]
[group("anvil")]
anvil-miri package="" test="" example="": anvil-miri-validate-prereqs (_anvil-miri-test "standard" package test example)

# Run affected Miri tests across a rotating seed range.
anvil-miri-race-coverage: anvil-miri-race-coverage-validate-prereqs (_anvil-miri-test "race-coverage" "" "" "")

# Run affected Miri tests with strict provenance checks.
anvil-miri-strict-provenance: anvil-miri-strict-provenance-validate-prereqs (_anvil-miri-test "strict-provenance" "" "" "")

# Run affected Miri tests with the Tree Borrows model.
anvil-miri-tree-borrows: anvil-miri-tree-borrows-validate-prereqs (_anvil-miri-test "tree-borrows" "" "" "")

# Run affected tests under the declared workspace MSRV; no MSRV is a no-op.
anvil-msrv-test: anvil-msrv-test-validate-prereqs anvil-impact
    cargo each {{ anvil_msrv_selection }} --once -- cargo '+{workspace-rust-version}' test '{packages}' --tests --all-features --locked
    cargo each {{ anvil_msrv_selection }} --once -- cargo '+{workspace-rust-version}' test '{packages}' --tests --locked

# Mutation-test code changed from the selected base branch.
anvil-mutants-diff: anvil-mutants-diff-validate-prereqs anvil-impact
    {{ anvil_mutants_diff_skip_prefix }}git diff --src-prefix=a/ --dst-prefix=b/ {{ quote(anvil_base_ref) }} --output={{ quote(anvil_mutants_diff_file) }} -- . ":(exclude)scripts/publish-gh-release.rs"
    {{ anvil_mutants_diff_skip_prefix }}cargo {{ anvil_stable_toolchain_arg }} gamma run --workspace --in-diff {{ quote(anvil_mutants_diff_file) }} --min-score 100 --max-flaky 0 --update-hints {{ if env("GITHUB_ACTIONS", "") == "true" { "--artifact-dir target/cargo-gamma" } else { "" } }}
    {{ anvil_mutants_diff_skip_prefix }}rm {{ quote(anvil_mutants_diff_file) }}

# Run exhaustive mutation testing across the workspace.
anvil-mutants-full: anvil-mutants-full-validate-prereqs
    cargo {{ anvil_stable_toolchain_arg }} gamma run --workspace --min-score 100 --max-flaky 0 --update-hints {{ if env("GITHUB_ACTIONS", "") == "true" { "--artifact-dir target/cargo-gamma" } else { "" } }}

# Validate the current pull request title against repository policy.
anvil-pr-title: anvil-pr-title-validate-prereqs
    {{ if anvil_pr_title == "" { "echo " + quote("anvil-pr-title: PR_TITLE env var is unset or empty; skipping title validation") } else if anvil_pr_title =~ anvil_pr_title_pattern { "# PR title matches the accepted Conventional Commits subset" } else { error(anvil_pr_title_error) } }}

# Check crate READMEs or regenerate them with --fix.
[arg("fix", long, value="true")]
anvil-readme fix="false": (_anvil-readme if fix == "true" { "generate" } else { "check" })
# Verify generated crate READMEs are current.
anvil-readme-check: (_anvil-readme "check")

# Check spelling in source comments and documentation.
[script("pwsh", "-NoProfile")]
anvil-spellcheck: anvil-spellcheck-validate-prereqs
    $ErrorActionPreference = 'Stop'
    $output_file = 'target/spelling.dic'
    $filtered_lines = @()
    if (Test-Path '.spelling') {
        $lines = Get-Content '.spelling' | Sort-Object
        $filtered_lines = @($lines | Where-Object { $_ -notmatch '^\d+$' -and $_ -ne '' })
    }
    $line_count = $filtered_lines.Count
    [System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($output_file)) | Out-Null
    @($line_count) + $filtered_lines | Set-Content $output_file
    & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} spellcheck --cfg spellcheck.toml check --code 1
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# Check required packages for unused normal and development dependencies.
anvil-udeps: anvil-udeps-validate-prereqs anvil-impact
    cargo +{{ rust_nightly }} each {{ anvil_required_selection }} --once -- cargo +{{ rust_nightly }} udeps '{packages}' --all-features
    cargo +{{ rust_nightly }} each {{ anvil_required_selection }} --once -- cargo +{{ rust_nightly }} udeps '{packages}' --all-features --all-targets

# Check global catalog inheritance and required packages' unused/misplaced dependencies.
[arg("fix", long, value="true")]
[script("pwsh", "-NoProfile")]
anvil-unused-deps fix="false": anvil-unused-deps-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    $pkg = @()
    if ('{{ anvil_impact_mode }}' -eq 'off') {
        $pkg += '--workspace'
    } else {
        $packageFile = {{ quote(anvil_impact_input_dir + "/required.packages") }}
        $packageText = Get-Content -Raw -LiteralPath $packageFile
        if (-not [string]::IsNullOrEmpty($packageText) -and [string]::IsNullOrWhiteSpace($packageText)) {
            Write-Error "anvil-unused-deps: $packageFile contains whitespace but no package specs"
            exit 1
        }
        foreach ($spec in @(Get-Content -LiteralPath $packageFile | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })) {
            $pkg += @('--package', $spec)
        }
    }
    # An empty required set leaves $pkg empty, so unused-deps runs only the workspace inheritance check.
    & cargo "+{{ rust_nightly }}" unused-deps @pkg {{ if fix == 'true' { '--fix' } else { '' } }}
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
